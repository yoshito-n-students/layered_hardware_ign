<?xml version="1.0"?>
<robot>

    <ros2_control name="LayeredHardwareIgnition" type="system">
        <hardware>
            <plugin>layered_hardware_ign/LayeredHardwareIgnition</plugin>
            <param name="layers">
                - name: monitor_layer
                  type: layered_hardware/MonitorLayer
                - name: joint_limits_layer
                  type: layered_hardware/JointLimitsLayer
                - name: gz_joint_layer
                  type: layered_hardware_gz/GazeboJointLayer
            </param>
            <param name="gz_joint_layer">
                joints:
                    axis:
                        operation_mode_map:
                            axis/position: position
                            axis/velocity: velocity
                            axis/effort: effort
            </param>
        </hardware>

        <joint name="axis">
            <command_interface name="position">
                <!-- <param name="min">-1.0</param> -->
                <!-- <param name="max">1.0</param> -->
            </command_interface>
            <command_interface name="velocity" />
            <command_interface name="effort" />
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

    </ros2_control>

    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find layered_hardware)/examples/single_actuator/config/controllers.yaml</parameters>
        </plugin>
    </gazebo>

</robot>